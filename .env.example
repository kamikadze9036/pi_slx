POSTGRES_DB=production_dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-this-database-password
ADMIN_API_KEY=change-this-admin-key
MES_PROVIDER=mock
SITE_TIMEZONE=Europe/Prague
POLL_SECONDS=10
VITE_APP_VERSION=0.1.0
# Ciclades: supply a read-only SQL Server account and approved query mapping.
# CICLADES_DSN=mssql+pymssql://readonly:password@sql-server:1433/database
# CICLADES_MAPPING_FILE=/app/config/ciclades-mapping.json
# Optional: existing Euromap63 service supplies live press state and links to its detail page.
# EUROMAP63_API_URL=http://host.docker.internal:8091
# EUROMAP63_FRONTEND_URL=http://VM-IP:8092
